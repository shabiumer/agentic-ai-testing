{
    "test_cases": [
        {
            "test_case_id": "TC-001",
            "test_scenario": "Calculate bill using valid previous and current meter readings with a standard unit rate",
            "test_type": "Positive",
            "requirement_ids": [
                "BR-001"
            ],
            "priority": "High",
            "test_input": {
                "previous_meter_reading": 1250,
                "current_meter_reading": 1350,
                "unit_rate": 0.25
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as 1250.",
                "Enter current meter reading as 1350.",
                "Enter unit rate as 0.25.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system calculates consumption as 100 units and bill amount as 25.00 (100 x 0.25). The bill is accepted and displayed successfully."
        },
        {
            "test_case_id": "TC-002",
            "test_scenario": "Calculate bill using decimal unit rate with valid readings",
            "test_type": "Positive",
            "requirement_ids": [
                "BR-001"
            ],
            "priority": "High",
            "test_input": {
                "previous_meter_reading": 5000,
                "current_meter_reading": 5125,
                "unit_rate": 0.1875
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as 5000.",
                "Enter current meter reading as 5125.",
                "Enter unit rate as 0.1875.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system calculates consumption as 125 units and bill amount as 23.4375 (125 x 0.1875). The bill is accepted and displayed successfully."
        },
        {
            "test_case_id": "TC-003",
            "test_scenario": "Reject negative previous meter reading",
            "test_type": "Negative",
            "requirement_ids": [
                "BR-002"
            ],
            "priority": "High",
            "test_input": {
                "previous_meter_reading": -10,
                "current_meter_reading": 100,
                "unit_rate": 0.25
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as -10.",
                "Enter current meter reading as 100.",
                "Enter unit rate as 0.25.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system rejects the input because the previous meter reading is negative. An error message is displayed and no bill is calculated."
        },
        {
            "test_case_id": "TC-004",
            "test_scenario": "Reject negative current meter reading",
            "test_type": "Negative",
            "requirement_ids": [
                "BR-002"
            ],
            "priority": "High",
            "test_input": {
                "previous_meter_reading": 1000,
                "current_meter_reading": -1,
                "unit_rate": 0.25
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as 1000.",
                "Enter current meter reading as -1.",
                "Enter unit rate as 0.25.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system rejects the input because the current meter reading is negative. An error message is displayed and no bill is calculated."
        },
        {
            "test_case_id": "TC-005",
            "test_scenario": "Reject current meter reading lower than previous meter reading",
            "test_type": "Negative",
            "requirement_ids": [
                "BR-003"
            ],
            "priority": "High",
            "test_input": {
                "previous_meter_reading": 1500,
                "current_meter_reading": 1499,
                "unit_rate": 0.25
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as 1500.",
                "Enter current meter reading as 1499.",
                "Enter unit rate as 0.25.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system rejects the input because the current meter reading is lower than the previous meter reading. An error message is displayed and no bill is calculated."
        },
        {
            "test_case_id": "TC-006",
            "test_scenario": "Allow zero consumption when current reading equals previous reading",
            "test_type": "Boundary",
            "requirement_ids": [
                "BR-001",
                "BR-003"
            ],
            "priority": "Medium",
            "test_input": {
                "previous_meter_reading": 2000,
                "current_meter_reading": 2000,
                "unit_rate": 0.25
            },
            "test_steps": [
                "Open the billing calculation screen.",
                "Enter previous meter reading as 2000.",
                "Enter current meter reading as 2000.",
                "Enter unit rate as 0.25.",
                "Submit the bill calculation."
            ],
            "expected_result": "The system accepts the input because the current reading is not lower than the previous reading. Consumption is 0 units and bill amount is 0.00."
        },
        {
            "test_case_id": "TC-007",
